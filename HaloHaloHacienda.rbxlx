  <Item class="ServerScriptService" referent="RBXServerScriptService">
    <Properties><string name="Name">ServerScriptService</string></Properties>
    <Item class="Script" referent="RBXMainScript">
      <Properties>
        <string name="Name">HaciendaServer</string>
        <bool name="Enabled">true</bool>
        <ProtectedString name="Source"><![CDATA[
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local event = ReplicatedStorage:WaitForChild("GameEvent")

local editor = workspace:FindFirstChild("HaciendaEditor")
if editor then editor:Destroy() end
local old = workspace:FindFirstChild("Hacienda")
if old then old:Destroy() end
local map = Instance.new("Folder")
map.Name = "Hacienda"
map.Parent = workspace

local COLORS = {grass=Color3.fromRGB(105,170,102), soil=Color3.fromRGB(112,72,42), wood=Color3.fromRGB(124,78,43), roof=Color3.fromRGB(211,128,73), cream=Color3.fromRGB(255,235,184), water=Color3.fromRGB(73,177,190), pink=Color3.fromRGB(241,147,170), purple=Color3.fromRGB(154,108,193), yellow=Color3.fromRGB(248,205,77), dark=Color3.fromRGB(54,39,34), leaf=Color3.fromRGB(55,134,70), red=Color3.fromRGB(198,72,57)}
local function part(name, size, pos, color, parent, material)
	local p = Instance.new("Part")
	p.Name=name; p.Size=size; p.Position=pos; p.Anchored=true; p.Color=color; p.Material=material or Enum.Material.SmoothPlastic; p.Parent=parent or map
	return p
end
local function label(parent, text, color)
	local gui=Instance.new("BillboardGui"); gui.Size=UDim2.fromOffset(180,42); gui.StudsOffset=Vector3.new(0,4,0); gui.AlwaysOnTop=true; gui.Parent=parent
	local t=Instance.new("TextLabel"); t.Size=UDim2.fromScale(1,1); t.BackgroundTransparency=1; t.Text=text; t.TextColor3=color or Color3.new(1,1,1); t.TextStrokeTransparency=.35; t.Font=Enum.Font.GothamBold; t.TextScaled=true; t.Parent=gui
end
local function prompt(parent, action, object)
	local q=Instance.new("ProximityPrompt"); q.ActionText=action; q.ObjectText=object; q.HoldDuration=.35; q.MaxActivationDistance=10; q.RequiresLineOfSight=false; q.Parent=parent; return q
end
local function model(name, parent)
	local m=Instance.new("Model"); m.Name=name; m.Parent=parent or map; return m
end
local function roof(name, size, pos, color, parent)
	local r=part(name,size,pos,color,parent,Enum.Material.WoodPlanks); r.CFrame=CFrame.new(pos)*CFrame.Angles(0,0,math.rad(7)); return r
end
local function tree(pos, parent)
	local m=model("MangoTree",parent)
	part("Trunk",Vector3.new(2.2,9,2.2),pos+Vector3.new(0,4.5,0),COLORS.wood,m,Enum.Material.Wood)
	local crown=part("LeafCanopy",Vector3.new(9,7,9),pos+Vector3.new(0,10,0),COLORS.leaf,m,Enum.Material.Grass); crown.Shape=Enum.PartType.Ball
	for _,offset in ipairs({Vector3.new(3,10,0),Vector3.new(-3,10,0),Vector3.new(0,12,2)}) do
		local leaf=part("LeafCluster",Vector3.new(5,4,5),pos+offset,COLORS.grass,m,Enum.Material.Grass); leaf.Shape=Enum.PartType.Ball
	end
end
local function building(name, center, size, wallColor, roofColor, caption, parent)
	local m=model(name,parent)
	local x,y,z=center.X,center.Y,center.Z; local sx,sy,sz=size.X,size.Y,size.Z
	part("BackWall",Vector3.new(sx,sy,.5),Vector3.new(x,y+sy/2,z+sz/2),wallColor,m,Enum.Material.Wood)
	part("LeftWall",Vector3.new(.5,sy,sz),Vector3.new(x-sx/2,y,z),wallColor,m,Enum.Material.Wood)
	part("RightWall",Vector3.new(.5,sy,sz),Vector3.new(x+sx/2,y,z),wallColor,m,Enum.Material.Wood)
	part("FrontLeft",Vector3.new((sx-4)/2,sy,.5),Vector3.new(x-(sx+4)/4,y,z-sz/2),wallColor,m,Enum.Material.Wood)
	part("FrontRight",Vector3.new((sx-4)/2,sy,.5),Vector3.new(x+(sx+4)/4,y,z-sz/2),wallColor,m,Enum.Material.Wood)
	part("Door",Vector3.new(3.2,5,.25),Vector3.new(x,y-1.5,z-sz/2-.15),COLORS.dark,m,Enum.Material.Wood)
	roof("Roof",Vector3.new(sx+3,1.2,sz+3),Vector3.new(x,y+sy/2+.7,z),roofColor,m)
	local sign=part("Sign",Vector3.new(7,1.5,.3),Vector3.new(x,y+sy/2+2,z-sz/2-1),roofColor,m,Enum.Material.Wood)
	label(sign,caption,COLORS.cream)
	return m
end
local function cropModel(pos, parent)
	local m=model("Crop",parent)
	part("Stem",Vector3.new(.35,2,.35),pos+Vector3.new(0,1,0),COLORS.leaf,m,Enum.Material.Grass)
	for _,offset in ipairs({Vector3.new(.45,1.2,0),Vector3.new(-.45,1.35,0),Vector3.new(0,1.7,.35)}) do
		local leaf=part("Leaf",Vector3.new(1.1,.22,.55),pos+offset,COLORS.leaf,m,Enum.Material.Grass); leaf.CFrame=CFrame.new(pos+offset)*CFrame.Angles(0,offset.Z,math.rad(offset.X*30))
	end
	local fruit=part("Fruit",Vector3.new(.7,.7,.7),pos+Vector3.new(0,2.1,0),COLORS.yellow,m,Enum.Material.SmoothPlastic); fruit.Shape=Enum.PartType.Ball
	return m
end
local function karabao(pos,parent)
	local m=model("Karabao",parent)
	local body=part("Body",Vector3.new(4,2.2,2.4),pos,COLORS.dark,m,Enum.Material.SmoothPlastic); body.Shape=Enum.PartType.Ball
	part("Head",Vector3.new(1.7,1.8,1.8),pos+Vector3.new(0,0,-1.7),COLORS.dark,m,Enum.Material.SmoothPlastic)
	for _,x in ipairs({-1.2,1.2}) do part("Leg",Vector3.new(.45,1.5,.45),pos+Vector3.new(x,-1,0),COLORS.dark,m,Enum.Material.SmoothPlastic) end
	for _,x in ipairs({-1.1,1.1}) do local horn=part("Horn",Vector3.new(.25,1.1,.25),pos+Vector3.new(x*.65,.9,-1.8),COLORS.cream,m,Enum.Material.SmoothPlastic); horn.CFrame=CFrame.new(horn.Position)*CFrame.Angles(0,0,math.rad(x*35)) end
	label(body,"KARABAO",COLORS.cream)
	return m
end

Lighting.ClockTime=17.2; Lighting.Brightness=2.2; Lighting.Ambient=Color3.fromRGB(120,105,110); Lighting.OutdoorAmbient=Color3.fromRGB(140,145,130)
part("Ground",Vector3.new(170,1,130),Vector3.new(0,-1,0),COLORS.grass,map,Enum.Material.Grass)
part("Plaza",Vector3.new(42,.35,42),Vector3.new(0,.1,0),Color3.fromRGB(202,157,102),map,Enum.Material.Cobblestone)
part("RoadWest",Vector3.new(12,.2,112),Vector3.new(-18,.2,0),Color3.fromRGB(183,139,92),map,Enum.Material.Ground)
part("RoadEast",Vector3.new(12,.2,112),Vector3.new(18,.2,0),Color3.fromRGB(183,139,92),map,Enum.Material.Ground)
part("River",Vector3.new(8,.2,130),Vector3.new(82,.25,0),COLORS.water,map,Enum.Material.Glass)
for _,pos in ipairs({Vector3.new(-78,0,-53),Vector3.new(-28,0,-53),Vector3.new(28,0,-53),Vector3.new(78,0,-53),Vector3.new(-78,0,53),Vector3.new(78,0,53)}) do tree(pos,map) end

building("AncestralHome",Vector3.new(0,4,39),Vector3.new(24,9,15),COLORS.wood,COLORS.roof,"HALO-HALO HACIENDA",map)
local cookModel=building("Kusina",Vector3.new(0,3,-39),Vector3.new(16,6,11),COLORS.cream,COLORS.purple,"KUSINA",map)
local cook=cookModel:FindFirstChild("Door")
local cookPrompt=prompt(cook,"Cook a Dish","Halo-Halo Station")

local marker=part("BayanihanMarker",Vector3.new(10,.5,10),Vector3.new(0,.5,0),COLORS.yellow,map,Enum.Material.Neon); marker.Shape=Enum.PartType.Cylinder; label(marker,"BAYANIHAN",COLORS.cream)
local markerPrompt=prompt(marker,"Join Task","Community Marker")
local shrineModel=building("SpiritShrine",Vector3.new(0,2,17),Vector3.new(12,4,8),COLORS.pink,COLORS.red,"SPIRIT SHRINE",map)
local shrine=shrineModel:FindFirstChild("Door")
local shrinePrompt=prompt(shrine,"Serve Spirits","Order Board")

local function announce(message) event:FireAllClients("Toast",message) end
local seedCatalog={
	{Name="Rice",Rarity="Common",Cost=2,Color=Color3.fromRGB(221,196,91)},
	{Name="Tomato",Rarity="Uncommon",Cost=4,Color=Color3.fromRGB(221,74,55)},
	{Name="Ube",Rarity="Rare",Cost=7,Color=Color3.fromRGB(145,91,201)},
	{Name="Mango",Rarity="Epic",Cost=12,Color=Color3.fromRGB(246,180,51)},
	{Name="Dragon Fruit",Rarity="Legendary",Cost=20,Color=Color3.fromRGB(238,74,135)}
}
local seedStock={}
local function resetSeedShop()
	seedStock={}
	for slot=1,5 do seedStock[slot]=seedCatalog[math.random(#seedCatalog)] end
	announce("The seed shop has refreshed! Five new plants are available.")
end
local shop=building("SeedShop",Vector3.new(32,3,0),Vector3.new(14,5,10),Color3.fromRGB(242,205,121),COLORS.red,"SEED SHOP",map)
local shopDoor=shop:FindFirstChild("Door")
local shopPrompt=prompt(shopDoor,"Browse Seeds","Seed Shop")
local seedStands={}
for slot=1,5 do
	local stand=part("SeedStand"..slot,Vector3.new(2.2,1.8,2.2),Vector3.new(26+slot*2.2,1.1,-6),COLORS.yellow,map,Enum.Material.Wood)
	local seedPrompt=prompt(stand,"Buy Seed","Seed Shop")
	seedStands[slot]={part=stand,prompt=seedPrompt}
	seedPrompt.Triggered:Connect(function(player)
		local seed=seedStock[slot]
		if not seed then return end
		local stats=player:FindFirstChild("leaderstats")
		local ngiti=stats and stats:FindFirstChild("Ngiti")
		if not ngiti or ngiti.Value<seed.Cost then event:FireClient(player,"Toast","You need "..seed.Cost.." Ngiti for "..seed.Name.."."); return end
		ngiti.Value-=seed.Cost
		player:SetAttribute("SelectedSeed",seed.Name)
		player:SetAttribute("SeedCount",(player:GetAttribute("SeedCount") or 0)+1)
		event:FireClient(player,"Toast","Bought "..seed.Rarity.." "..seed.Name.." seed. Plant it on your leased plot!")
	end)
end
shopPrompt.Triggered:Connect(function(player)
	local names={}
	for slot=1,5 do local seed=seedStock[slot]; names[slot]=seed.Name.." ("..seed.Rarity..", "..seed.Cost.." Ngiti)" end
	event:FireClient(player,"Shop",table.concat(names," | "))
end)
resetSeedShop()
task.spawn(function() while true do task.wait(300); resetSeedShop() end end)

local plots={}
local function makePlot(index, x, z)
	local folder=model("Plot"..index,map)
	part("PlotBorder",Vector3.new(27,.35,21),Vector3.new(x,.3,z),COLORS.wood,folder,Enum.Material.Wood)
	part("Soil",Vector3.new(24,.3,18),Vector3.new(x,.5,z),COLORS.soil,folder,Enum.Material.Ground)
	local sign=part("PlotSign",Vector3.new(5,3,.4),Vector3.new(x-10,2,z-10),COLORS.wood,folder,Enum.Material.Wood); label(sign,"PLOT "..index,COLORS.cream)
	for row=-1,1 do for col=-1,1 do
		local spot=part("CropSpot",Vector3.new(5,.25,3.8),Vector3.new(x+col*6,.7,z+row*5),Color3.fromRGB(83,51,31),folder,Enum.Material.Ground)
		local pr=prompt(spot,"Plant / Harvest","Crop Bed")
		pr.Triggered:Connect(function(player)
			if player:GetAttribute("Plot")~=index then event:FireClient(player,"Toast","This is Plot "..index..". Your plot is Plot "..(player:GetAttribute("Plot") or "?").."."); return end
			local crop=spot:FindFirstChild("Crop")
			if crop then crop:Destroy(); player.leaderstats.Ngiti.Value+=2; event:FireClient(player,"Toast","Harvested a fresh crop! +2 Ngiti"); return end
			if (player:GetAttribute("SeedCount") or 0)<=0 then event:FireClient(player,"Toast","Visit the Seed Shop to buy a plant first."); return end
			local sprout=cropModel(spot.Position,folder); sprout:SetAttribute("Owner",player.UserId); event:FireClient(player,"Toast","A seed is growing! Come back to harvest.")
			player:SetAttribute("SeedCount",player:GetAttribute("SeedCount")-1)
		end)
	end end
	local pet=karabao(Vector3.new(x+8,2,z+7),folder)
	local petBody=pet:FindFirstChild("Body")
	local petPrompt=prompt(petBody,"Pet Karabao","Friendly Karabao")
	petPrompt.Triggered:Connect(function(player) if player:GetAttribute("Plot")==index then player.leaderstats.Ngiti.Value+=1; event:FireClient(player,"Toast","Your karabao is happy! +1 Ngiti") end end)
	plots[index]={x=x,z=z}
end
makePlot(1,-55,-30); makePlot(2,-55,0); makePlot(3,-55,30); makePlot(4,55,-30); makePlot(5,55,0); makePlot(6,55,30)

local orders={"Ube Halaya","Sinigang","Adobo","Leche Flan"}; local order=orders[math.random(#orders)]; local taskOpen=false; local taskEnds=0; local contributors={}
local function startTask()
	if taskOpen then return end
	taskOpen=true; taskEnds=os.clock()+35; contributors={}; announce("BAYANIHAN! Everyone to the glowing marker!"); event:FireAllClients("Task",true,35)
	task.spawn(function()
		while taskOpen and os.clock()<taskEnds do task.wait(1); event:FireAllClients("Task",true,math.max(0,math.ceil(taskEnds-os.clock())),#contributors) end
		if taskOpen then taskOpen=false; event:FireAllClients("Task",false,0,#contributors); if #contributors>=3 then announce("Bayanihan complete! Everyone gets 2x Ngiti for 60 seconds!"); for _,p in ipairs(Players:GetPlayers()) do p:SetAttribute("BlessedUntil",os.clock()+60) end else announce("The task is over. The village will try again soon!") end end
	end)
end
markerPrompt.Triggered:Connect(function(player) if taskOpen and not table.find(contributors,player.UserId) then table.insert(contributors,player.UserId); event:FireClient(player,"Toast","You joined Bayanihan! Every helping hand counts.") elseif not taskOpen then event:FireClient(player,"Toast","The next Bayanihan task is coming soon.") end end)
cookPrompt.Triggered:Connect(function(player) player.leaderstats.Ngiti.Value+=5; event:FireClient(player,"Toast","Lutong Bahay! You cooked "..order..". +5 Ngiti"); order=orders[math.random(#orders)] end)
shrinePrompt.Triggered:Connect(function(player) player.leaderstats.Ngiti.Value+=3; event:FireClient(player,"Toast","The spirits loved your offering! +3 Ngiti"); event:FireClient(player,"Order",order) end)
task.spawn(function() while true do task.wait(15); startTask() end end)

local function assign(player)
	local used={}; for _,p in ipairs(Players:GetPlayers()) do if p~=player and p:GetAttribute("Plot") then used[p:GetAttribute("Plot")]=true end end
	for i=1,6 do if not used[i] then player:SetAttribute("Plot",i); break end end
	local stats=Instance.new("Folder"); stats.Name="leaderstats"; stats.Parent=player; local ngiti=Instance.new("IntValue"); ngiti.Name="Ngiti"; ngiti.Value=0; ngiti.Parent=stats
	player:SetAttribute("BlessedUntil",0); event:FireClient(player,"Welcome",player:GetAttribute("Plot"),order)
	player:SetAttribute("SelectedSeed","Rice"); player:SetAttribute("SeedCount",0)
end
Players.PlayerAdded:Connect(assign)
Players.PlayerRemoving:Connect(function(player) end)
for _,player in ipairs(Players:GetPlayers()) do assign(player) end
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBXStarterPlayer">
    <Properties><string name="Name">StarterPlayer</string></Properties>
    <Item class="StarterPlayerScripts" referent="RBXStarterPlayerScripts">
      <Properties><string name="Name">StarterPlayerScripts</string></Properties>
      <Item class="LocalScript" referent="RBXClientScript">
        <Properties>
          <string name="Name">HaciendaClient</string>
          <bool name="Enabled">true</bool>
          <ProtectedString name="Source"><![CDATA[
local Players=game:GetService("Players"); local ReplicatedStorage=game:GetService("ReplicatedStorage"); local TweenService=game:GetService("TweenService")
local player=Players.LocalPlayer; local event=ReplicatedStorage:WaitForChild("GameEvent")
local gui=Instance.new("ScreenGui"); gui.Name="HaciendaHUD"; gui.ResetOnSpawn=false; gui.IgnoreGuiInset=true; gui.Parent=player:WaitForChild("PlayerGui")
local palette={ink=Color3.fromRGB(54,39,45), cream=Color3.fromRGB(255,246,220), gold=Color3.fromRGB(255,214,105), mint=Color3.fromRGB(174,235,190), green=Color3.fromRGB(47,91,76), darkGreen=Color3.fromRGB(29,53,46), purple=Color3.fromRGB(104,72,112), pink=Color3.fromRGB(241,147,170)}
local function panel(name,size,pos,color,parent)
	local f=Instance.new("Frame"); f.Name=name; f.Size=size; f.Position=pos; f.BackgroundColor3=color; f.BorderSizePixel=0; f.Parent=parent or gui
	local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,14); c.Parent=f
	local s=Instance.new("UIStroke"); s.Color=Color3.fromRGB(255,224,132); s.Transparency=.72; s.Thickness=1; s.Parent=f
	return f
end
local function text(name,size,pos,value,color,font,parent)
	local t=Instance.new("TextLabel"); t.Name=name; t.Size=size; t.Position=pos; t.BackgroundTransparency=1; t.Text=value; t.TextColor3=color; t.Font=font or Enum.Font.Gotham; t.TextSize=16; t.TextWrapped=true; t.TextXAlignment=Enum.TextXAlignment.Left; t.Parent=parent or gui; return t
end
local top=panel("StatusCard",UDim2.fromOffset(390,122),UDim2.fromOffset(20,20),palette.ink)
local accent=Instance.new("Frame"); accent.Size=UDim2.new(0,6,1,0); accent.BackgroundColor3=palette.gold; accent.BorderSizePixel=0; accent.Parent=top
local title=text("Title",UDim2.new(1,-38,0,30),UDim2.fromOffset(24,12),"HALO-HALO HACIENDA",palette.gold,Enum.Font.GothamBlack,top); title.TextSize=21
local subtitle=text("Subtitle",UDim2.new(1,-38,0,20),UDim2.fromOffset(24,40),"A cozy village built by every helping hand",palette.mint,Enum.Font.GothamMedium,top); subtitle.TextSize=13
local info=text("PlayerInfo",UDim2.new(1,-38,0,25),UDim2.fromOffset(24,68),"PLOT -  |  NGITI 0",palette.cream,Enum.Font.GothamBold,top); info.TextSize=17
local tip=text("Tip",UDim2.new(1,-38,0,18),UDim2.fromOffset(24,96),"Plant, pet, cook, and help your neighbors.",Color3.fromRGB(214,201,187),Enum.Font.Gotham,top); tip.TextSize=12
local toast=panel("Toast",UDim2.fromOffset(560,64),UDim2.new(.5,-280,0,154),palette.purple); toast.Visible=false
local toastText=text("Message",UDim2.new(1,-34,1,-16),UDim2.fromOffset(17,8),"",palette.cream,Enum.Font.GothamBold,toast); toastText.TextSize=17; toastText.TextXAlignment=Enum.TextXAlignment.Center
local taskFrame=panel("BayanihanCard",UDim2.fromOffset(540,112),UDim2.new(.5,-270,1,-140),palette.green); taskFrame.Visible=false
local taskTitle=text("TaskTitle",UDim2.new(1,-32,0,27),UDim2.fromOffset(16,12),"BAYANIHAN COMMUNITY TASK",palette.gold,Enum.Font.GothamBlack,taskFrame); taskTitle.TextSize=17
local taskText=text("TaskText",UDim2.new(1,-32,0,20),UDim2.fromOffset(16,39),"Gather 3 helpers",palette.cream,Enum.Font.GothamMedium,taskFrame); taskText.TextSize=14
local bar=Instance.new("Frame"); bar.Position=UDim2.fromOffset(16,72); bar.Size=UDim2.new(1,-32,0,18); bar.BackgroundColor3=palette.darkGreen; bar.BorderSizePixel=0; bar.Parent=taskFrame
local barCorner=Instance.new("UICorner"); barCorner.CornerRadius=UDim.new(1,0); barCorner.Parent=bar
local fill=Instance.new("Frame"); fill.Size=UDim2.fromScale(0,1); fill.BackgroundColor3=palette.gold; fill.BorderSizePixel=0; fill.Parent=bar
local fillCorner=Instance.new("UICorner"); fillCorner.CornerRadius=UDim.new(1,0); fillCorner.Parent=fill
local shopFrame=panel("ShopCard",UDim2.fromOffset(360,330),UDim2.new(1,-380,0,20),palette.ink); shopFrame.Visible=false
local shopTitle=text("ShopTitle",UDim2.new(1,-60,0,30),UDim2.fromOffset(18,14),"SEED SHOP",palette.gold,Enum.Font.GothamBlack,shopFrame); shopTitle.TextSize=20
local shopHint=text("ShopHint",UDim2.new(1,-36,0,34),UDim2.fromOffset(18,46),"Five seeds rotate every 5 minutes. Buy with Ngiti, then plant on your plot.",palette.mint,Enum.Font.Gotham,shopFrame); shopHint.TextSize=12
local close=Instance.new("TextButton"); close.Size=UDim2.fromOffset(32,32); close.Position=UDim2.new(1,-45,0,12); close.Text="X"; close.TextColor3=palette.cream; close.TextSize=16; close.Font=Enum.Font.GothamBold; close.BackgroundColor3=palette.pink; close.Parent=shopFrame
local closeCorner=Instance.new("UICorner"); closeCorner.CornerRadius=UDim.new(1,0); closeCorner.Parent=close
close.MouseButton1Click:Connect(function() shopFrame.Visible=false end)
local shopList=Instance.new("Frame"); shopList.Size=UDim2.new(1,-36,1,-94); shopList.Position=UDim2.fromOffset(18,90); shopList.BackgroundTransparency=1; shopList.Parent=shopFrame
local list=Instance.new("UIListLayout"); list.Padding=UDim.new(0,7); list.Parent=shopList
local toastId=0
local function show(message)
	toastId+=1; local id=toastId; toastText.Text=message; toast.Visible=true; toast.BackgroundTransparency=0; toastText.TextTransparency=0
	task.delay(3,function() if id==toastId then TweenService:Create(toast,TweenInfo.new(.35),{BackgroundTransparency=1}):Play(); TweenService:Create(toastText,TweenInfo.new(.35),{TextTransparency=1}):Play(); task.wait(.35); if id==toastId then toast.Visible=false end end end)
end
local function showShop(items)
	for _,child in ipairs(shopList:GetChildren()) do if child:IsA("TextLabel") then child:Destroy() end end
	for item in string.gmatch(items,"[^|]+") do
		local row=Instance.new("TextLabel"); row.Size=UDim2.new(1,0,0,34); row.BackgroundColor3=Color3.fromRGB(74,54,67); row.TextColor3=palette.cream; row.Font=Enum.Font.GothamBold; row.TextSize=13; row.Text=item:gsub("^%s+",""):gsub("%s+$",""); row.TextXAlignment=Enum.TextXAlignment.Left; row.Parent=shopList
		local rc=Instance.new("UICorner"); rc.CornerRadius=UDim.new(0,8); rc.Parent=row
	end
	shopFrame.Visible=true
end
event.OnClientEvent:Connect(function(kind,a,b,c)
	if kind=="Welcome" then info.Text="PLOT "..a.."  |  NGITI 0"; show("Mabuhay! Your plot is ready. Today's order: "..b)
	elseif kind=="Toast" then show(a)
	elseif kind=="Order" then show("Spirit order: "..a.." | Cook at the Kusina")
	elseif kind=="Shop" then showShop(a)
	elseif kind=="Task" then taskFrame.Visible=a; if a then local needed=3; local count=c or 0; fill.Size=UDim2.fromScale(math.clamp(count/needed,0,1),1); taskText.Text=count.."/"..needed.." helpers joined  |  "..b.." seconds left" end end
end)
task.spawn(function() while true do task.wait(1); local stats=player:FindFirstChild("leaderstats"); if stats and stats:FindFirstChild("Ngiti") then info.Text="PLOT "..(player:GetAttribute("Plot") or "-").."  |  NGITI "..stats.Ngiti.Value.."  |  SEEDS "..(player:GetAttribute("SeedCount") or 0) end end end)
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
