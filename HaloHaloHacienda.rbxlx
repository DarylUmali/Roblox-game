        <Item class="Model" referent="RBXEditorPlot5"><Properties><string name="Name">Plot5</string></Properties><Item class="Part" referent="RBXEditorSoil5"><Properties><string name="Name">Soil</string><Vector3 name="Size">24,0.3,18</Vector3><CFrame name="CFrame">55,0.5,0,1,0,0,0,1,0,0,0,1</CFrame><bool name="Anchored">true</bool><Color3 name="Color">0.439,0.282,0.165</Color3><token name="Material">512</token></Properties></Item><Item class="Part" referent="RBXEditorBorder5"><Properties><string name="Name">PlotBorder</string><Vector3 name="Size">27,0.35,21</Vector3><CFrame name="CFrame">55,0.3,0,1,0,0,0,1,0,0,0,1</CFrame><bool name="Anchored">true</bool><Color3 name="Color">0.486,0.306,0.169</Color3><token name="Material">512</token></Properties></Item></Item>
        <Item class="Model" referent="RBXEditorPlot6"><Properties><string name="Name">Plot6</string></Properties><Item class="Part" referent="RBXEditorSoil6"><Properties><string name="Name">Soil</string><Vector3 name="Size">24,0.3,18</Vector3><CFrame name="CFrame">55,0.5,30,1,0,0,0,1,0,0,0,1</CFrame><bool name="Anchored">true</bool><Color3 name="Color">0.439,0.282,0.165</Color3><token name="Material">512</token></Properties></Item><Item class="Part" referent="RBXEditorBorder6"><Properties><string name="Name">PlotBorder</string><Vector3 name="Size">27,0.35,21</Vector3><CFrame name="CFrame">55,0.3,30,1,0,0,0,1,0,0,0,1</CFrame><bool name="Anchored">true</bool><Color3 name="Color">0.486,0.306,0.169</Color3><token name="Material">512</token></Properties></Item></Item>
